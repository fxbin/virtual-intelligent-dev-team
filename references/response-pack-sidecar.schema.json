    "resume": {
      "type": "object",
      "required": [
        "progress_anchor",
        "resume_artifacts"
      ],
      "properties": {
        "progress_anchor": {
          "type": "string"
        },
        "resume_artifacts": {
          "$ref": "#/$defs/string_array"
        }
      },
      "additionalProperties": false
    },
    "git_workflow": {
      "type": "object",
      "required": [
        "using_git_worktrees",
        "git_workflow",
        "suggested_branch",
        "suggested_commit",
        "suggested_pr_title"
      ],
      "properties": {
        "using_git_worktrees": {
          "type": "boolean"
        },
        "git_workflow": {
          "type": "boolean"
        },
        "suggested_branch": {
          "type": "string"
        },
        "suggested_commit": {
          "type": "string"
        },
        "suggested_pr_title": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": [
        "roundtable_enabled",
        "selected_track",
        "risk_level",
        "dual_sign_required"
      ],
      "properties": {
        "roundtable_enabled": {
          "type": "boolean"
        },
        "selected_track": {
          "type": "string"
        },
        "risk_level": {
          "type": "string"
        },
        "dual_sign_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "bundle_bootstrap": {
      "type": "object",
      "required": [
        "required",
        "reference",
        "commands",
        "artifacts",
        "resume_anchor"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reference": {
          "type": "string"
        },
        "commands": {
          "$ref": "#/$defs/string_array"
        },
        "artifacts": {
          "$ref": "#/$defs/string_array"
        },
        "resume_anchor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "engineering_constraints": {
      "type": "object",
      "required": [
        "required",
        "reference",
        "artifact",
        "command",
        "verification_check"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reference": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "verification_check": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "team_engine": {
      "type": "object",
      "required": [
        "required",
        "reference",
        "cycle_reference",
        "workflow_bundle",
        "lead_role",
        "worker_role",
        "verifier_role",
        "max_cycles",
        "acceptance_gates",
        "producer_can_self_pass",
        "leader_accept_requires_cycle_report",
        "verifier_fail_requires_remediation_patch",
        "runtime_claim",
        "team_engine_closure_verdict",
        "reason"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reference": {
          "type": "string"
        },
        "cycle_reference": {
          "type": "string"
        },
        "workflow_bundle": {
          "type": "string"
        },
        "lead_role": {
          "type": "string"
        },
        "worker_role": {
          "type": "string"
        },
        "verifier_role": {
          "type": "string"
        },
        "max_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "acceptance_gates": {
          "$ref": "#/$defs/string_array"
        },
        "producer_can_self_pass": {
          "type": "boolean"
        },
        "leader_accept_requires_cycle_report": {
          "type": "boolean"
        },
        "verifier_fail_requires_remediation_patch": {
          "type": "boolean"
        },
        "runtime_claim": {
          "type": "string"
        },
        "team_engine_closure_verdict": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "external_agent_backend": {
      "type": "object",
      "required": [
        "enabled",
        "reference",
        "orchestration_mode",
        "runtime_claim",
        "backend_orchestration_verdict",
        "team_engine_closure_verdict",
        "required_outputs",
        "boundary_note"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "reference": {
          "type": "string"
        },
        "orchestration_mode": {
          "type": "string"
        },
        "runtime_claim": {
          "type": "string"
        },
        "backend_orchestration_verdict": {
          "type": "string"
        },
        "team_engine_closure_verdict": {
          "type": "string"
        },
        "required_outputs": {
          "$ref": "#/$defs/string_array"
        },
        "boundary_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "real_subagent_runtime_agent": {
      "type": "object",
      "required": [
        "role",
        "task",
        "write_scope",
        "context_policy",
        "output_contract",
        "can_write_artifact",
        "can_write_verdict",
        "mapped_role"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "write_scope": {
          "type": "string"
        },
        "context_policy": {
          "type": "string"
        },
        "output_contract": {
          "type": "string"
        },
        "can_write_artifact": {
          "type": "boolean"
        },
        "can_write_verdict": {
          "type": "boolean"
        },
        "mapped_role": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "real_subagent_runtime": {
      "type": "object",
      "required": [
        "eligible",
        "reference",
        "runtime_claim",
        "candidate_runtime_claim",
        "candidate_multi_session_claim",
        "runtime_evidence_required",
        "runtime_evidence",
        "runtime_downgraded_from",
        "runtime_downgrade_reason",
        "activation_reason",
        "workflow_bundle",
        "max_subagents",
        "tier_selection_algorithm",
        "tier_selection_function",
        "session_circuit_breaker",
        "spawn_policy",
        "agents",
        "merge_policy",
        "fallback"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "reference": {
          "type": "string"
        },
        "runtime_claim": {
          "type": "string"
        },
        "candidate_runtime_claim": {
          "type": "string"
        },
        "candidate_multi_session_claim": {
          "type": "string"
        },
        "runtime_evidence_required": {
          "type": "boolean"
        },
        "runtime_evidence": {
          "type": "object",
          "required": [
            "evidence_source",
            "spawn_supported",
            "wait_supported",
            "merge_supported",
            "create_session_supported",
            "kill_session_supported",
            "restart_session_supported",
            "real_chain_ready",
            "session_chain_ready",
            "candidate_ceiling",
            "smoke_test"
          ],
          "properties": {
            "evidence_source": {
              "enum": ["declared", "probed"]
            },
            "spawn_supported": {"type": "boolean"},
            "wait_supported": {"type": "boolean"},
            "merge_supported": {"type": "boolean"},
            "create_session_supported": {"type": "boolean"},
            "kill_session_supported": {"type": "boolean"},
            "restart_session_supported": {"type": "boolean"},
            "real_chain_ready": {"type": "boolean"},
            "session_chain_ready": {"type": "boolean"},
            "candidate_ceiling": {"type": "string"},
            "smoke_test": {
              "type": "object",
              "required": ["passed", "reason"],
              "properties": {
                "passed": {"type": "boolean"},
                "reason": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "runtime_downgraded_from": {
          "type": "string"
        },
        "runtime_downgrade_reason": {
          "type": "string"
        },
        "activation_reason": {
          "type": "string"
        },
        "workflow_bundle": {
          "type": "string"
        },
        "max_subagents": {
          "type": "integer",
          "minimum": 0
        },
        "tier_selection_algorithm": {
          "type": "string"
        },
        "tier_selection_function": {
          "type": "string"
        },
        "session_circuit_breaker": {
          "type": "object",
          "required": [
            "applicable_tier",
            "failure_threshold",
            "kill",
            "restart",
            "isolate_context",
            "escalation",
            "owner"
          ],
          "properties": {
            "applicable_tier": {"type": "string"},
            "failure_threshold": {"type": "integer", "minimum": 1},
            "kill": {"type": "string"},
            "restart": {"type": "string"},
            "isolate_context": {"type": "string"},
            "escalation": {"type": "string"},
            "owner": {"type": "string"}
          },
          "additionalProperties": false
        },
        "spawn_policy": {
          "type": "object",
          "required": [
            "user_explicit_or_auto_required",
            "no_default_swarm",
            "blocking_work_stays_local",
            "parallel_tasks_must_be_independent",
            "code_workers_need_disjoint_write_scopes"
          ],
          "properties": {
            "user_explicit_or_auto_required": {
              "type": "boolean"
            },
            "no_default_swarm": {
              "type": "boolean"
            },
            "blocking_work_stays_local": {
              "type": "boolean"
            },
            "parallel_tasks_must_be_independent": {
              "type": "boolean"
            },
            "code_workers_need_disjoint_write_scopes": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/real_subagent_runtime_agent"
          }
        },
        "merge_policy": {
          "type": "object",
          "required": [
            "lead_merges_only",
            "verifier_before_acceptance",
            "delivery_cycle_report_required",
            "conflict_resolution"

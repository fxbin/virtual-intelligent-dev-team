      "required": [
        "status",
        "reason",
        "recommended_skill",
        "next_step"
      ],
      "properties": {
        "status": {
          "enum": [
            "in_scope",
            "out_of_scope",
            "insufficient_information"
          ]
        },
        "reason": {
          "type": "string"
        },
        "recommended_skill": {
          "type": "string"
        },
        "next_step": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "team_dispatch": {
      "type": "object",
      "required": [
        "lead_agent",
        "assistant_agents",
        "workflow_bundle",
        "bundle_confidence",
        "workflow_bundle_source",
        "route_reason",
        "workflow_source_explanation"
      ],
      "properties": {
        "lead_agent": {
          "type": "string"
        },
        "assistant_agents": {
          "$ref": "#/$defs/string_array"
        },
        "workflow_bundle": {
          "type": "string"
        },
        "bundle_confidence": {
          "type": "number"
        },
        "workflow_bundle_source": {
          "type": "string"

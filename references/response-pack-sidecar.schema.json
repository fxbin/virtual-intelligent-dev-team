          "type": "object",
          "required": [
            "enabled",
            "summary"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "summary": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "micro_practice_item": {
      "type": "object",
      "required": [
        "name",
        "reference",
        "reason",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/string_array"
        }
      },
      "additionalProperties": false
    },
    "micro_practices": {
      "type": "object",
      "required": [
        "names",
        "items",
        "ledger"
      ],
      "properties": {
        "names": {
          "$ref": "#/$defs/string_array"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/micro_practice_item"
          }

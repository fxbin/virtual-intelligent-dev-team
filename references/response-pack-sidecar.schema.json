{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-hub:virtual-intelligent-dev-team:response-pack-sidecar.schema",
  "title": "Virtual Intelligent Dev Team Response Pack Sidecar",
  "type": "object",
  "required": [
    "schema_version",
    "language",
    "template",
    "team_dispatch",
    "execution_result",
    "evidence",
    "completion_evidence",
    "micro_practices",
    "next_action",
    "resume",
    "git_workflow",
    "governance"
  ],

            "command",
            "update_command",
            "evaluation_command",
            "resume_anchor",
            "schema",
            "evaluation_schema"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "command": {
              "type": "string"
            },
            "update_command": {
              "type": "string"
            },
            "evaluation_command": {
              "type": "string"
            },
            "resume_anchor": {
              "type": "string"
            },
            "schema": {
              "type": "string"
            },
            "evaluation_schema": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "stage_council_role": {
      "type": "object",
      "required": [
        "role",
        "owns"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "owns": {
          "$ref": "#/$defs/string_array"
        }
      },
      "additionalProperties": false

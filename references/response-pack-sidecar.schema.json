    },
    "micro_practices": {
      "$ref": "#/$defs/micro_practices"
    },
    "stage_councils": {
      "$ref": "#/$defs/stage_councils"
    },
    "intent_confirmation": {
      "$ref": "#/$defs/intent_confirmation"
    },
    "scope_boundary": {
      "$ref": "#/$defs/scope_boundary"
    },
    "completion_evidence": {
      "$ref": "#/$defs/completion_evidence"
    },
    "next_action": {
      "$ref": "#/$defs/next_action"
    },
    "resume": {
      "$ref": "#/$defs/resume"
    },
    "git_workflow": {
      "$ref": "#/$defs/git_workflow"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "bundle_bootstrap": {
      "$ref": "#/$defs/bundle_bootstrap"
    },
    "engineering_constraints": {
      "$ref": "#/$defs/engineering_constraints"
    },
    "team_engine": {
      "$ref": "#/$defs/team_engine"
    },
    "external_agent_backend": {
      "$ref": "#/$defs/external_agent_backend"
    },
    "real_subagent_runtime": {
      "$ref": "#/$defs/real_subagent_runtime"
    },
    "beta_program": {
      "$ref": "#/$defs/beta_program"
    },
    "planning_pack": {
      "$ref": "#/$defs/planning_pack"
    },
    "optimization_loop": {
      "$ref": "#/$defs/optimization_loop"
    },
    "auto_run": {
      "$ref": "#/$defs/auto_run"
    },
    "automation_resume": {
      "$ref": "#/$defs/automation_resume"
    }

      "properties": {
        "key_conclusion": {
          "type": "string"
        },
        "key_decision": {
          "type": "string"
        },
        "main_risks": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "route_evidence",
        "workflow_source_explanation",
        "process_skills",
        "assistant_delta_contract"
      ],
      "properties": {
        "route_evidence": {
          "type": "string"
